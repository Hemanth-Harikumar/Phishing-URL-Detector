# Optional: enable LLM-generated reports. Without this, a local evidence-grounded report is shown.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional for OpenAI-compatible providers:
# OPENAI_BASE_URL=https://your-provider.example/v1

FLASK_SECRET_KEY=generate-a-unique-random-secret-before-deployment
# Set to 1 only when HTTPS is enabled (recommended for public deployment).
COOKIE_SECURE=0
# Optional bind settings; keep HOST at 127.0.0.1 for local-only use.
HOST=127.0.0.1
PORT=5000

# Optional: override the model's stored classification threshold (default: 0.71).
# Lower values (e.g. 0.60) increase recall but may flag more legitimate URLs as suspicious.
# Higher values reduce false positives but miss more phishing URLs.
# Accepted range: 0.30 – 0.95
# MODEL_THRESHOLD=0.60
